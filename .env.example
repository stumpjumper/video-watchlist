# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required for AI summary generation (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — path to directory containing server.crt and server.key
# If set, HTTPS is enabled on HTTPS_PORT (default 443)
# CERT_DIR=/path/to/certs

# Optional — defaults to 4000 (HTTP) and 443 (HTTPS)
# PORT=4000
# HTTPS_PORT=443

# Required for the Overcast podcast feed (/feed/:token/*.xml) — generate with
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
FEED_TOKEN=your_random_feed_token_here

# Optional — base URL prepended to audio enclosure links in the podcast feed.
# Defaults to the Tailscale HTTPS endpoint documented in CLAUDE.md.
# PUBLIC_AUDIO_BASE_URL=https://turbo.taild6cb04.ts.net:4443

# Optional — base URL prepended to the feed's <link> and artwork, used by
# Overcast's server-side crawler infrastructure (not the device directly),
# so this must be a genuinely public hostname. Do NOT put Tailscale Funnel
# on this app's own host (breaks it for iPhone browsers using iCloud
# Private Relay — see CLAUDE.md's Podcast feed section) — Funnel runs on a
# separate node instead.
# PUBLIC_FEED_BASE_URL=https://condor.taild6cb04.ts.net
